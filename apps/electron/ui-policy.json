{
  "fonts": [
    "ui-sans-serif",
    "ui-monospace",
    "system-ui",
    "-apple-system",
    "BlinkMacSystemFont",
    "SF Pro Text",
    "SF Pro Display",
    "Segoe UI",
    "Roboto",
    "Helvetica",
    "Arial",
    "sans-serif",
    "Menlo",
    "Consolas",
    "monospace"
  ],
  "fontSizes": [
    10,
    11,
    11.5,
    12,
    12.5,
    13,
    13.5,
    14,
    15,
    16,
    17,
    18,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "typeRules": [
    {
      "selector": "h1",
      "sizes": [
        20,
        24,
        32,
        40,
        48,
        64
      ]
    },
    {
      "selector": "h2",
      "sizes": [
        20,
        24,
        32
      ]
    },
    {
      "selector": "h3",
      "sizes": [
        18,
        20,
        24
      ]
    },
    {
      "selector": "button, [role=button]",
      "sizes": [
        10,
        11,
        11.5,
        12,
        13,
        13.5,
        14,
        15,
        16
      ]
    }
  ],
  "minControlSize": 15,
  "controlSizeRules": [],
  "minControlGap": 8,
  "minControlInset": 8,
  "controlContainers": [
    "[data-ui-container]"
  ],
  "minLayoutGap": 8,
  "bannedCopy": [
    "unlock your potential",
    "seamlessly",
    "game-changing"
  ],
  "viewports": [
    {
      "width": 390,
      "height": 844
    },
    {
      "width": 1440,
      "height": 900
    }
  ],
  "colorSchemes": [
    "light"
  ],
  "exceptions": [
    {
      "selector": "span",
      "rules": ["content-clipping"],
      "reason": "Compact UI text is intentionally truncated by the viewport or overflow containers."
    }
  ]
}
